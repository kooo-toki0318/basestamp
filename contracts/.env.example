# Base deployment configuration. Copy to the ignored contracts/.env.
# deploy-mainnet.sh does not read this file automatically. Before invoking it,
# explicitly export these values in the current shell as documented in README.
# Never put a private key in this file.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_SEPOLIA_DEPLOYER_ADDRESS=

# Mainnet values are used only by the guarded deploy-mainnet.sh ceremony.
BASE_MAINNET_RPC_URL=https://mainnet.base.org
BASE_MAINNET_DEPLOYER_ADDRESS=

# browser (default), keystore, ledger, or trezor
BASESTAMP_SIGNER_MODE=browser
# Foundry's local browser-wallet bridge. The Dev Container forwards this port.
BASESTAMP_BROWSER_PORT=9545

# Used by Foundry's Etherscan-compatible source verifier. It is mandatory for
# deploy-mainnet.sh and must remain an uncommitted environment value.
ETHERSCAN_API_KEY=
