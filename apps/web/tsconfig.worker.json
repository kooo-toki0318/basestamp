{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["@cloudflare/workers-types", "vitest"]
  },
  "include": ["worker", "test", "src/lib", "src/locale.ts", "src/auth-client.ts", "src/locale-negotiation.ts", "src/handoff-role.ts", "src/create-wallet-state.ts", "src/sponsored-stamp.ts", "src/workers"]
}
