{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "@cloudflare/workers-types",
      "@cloudflare/vitest-pool-workers/types",
      "vitest"
    ]
  },
  "include": ["worker", "test", "test-d1", "src/lib", "src/locales", "src/locale.ts", "src/auth-client.ts", "src/locale-negotiation.ts", "src/handoff-role.ts", "src/create-wallet-state.ts", "src/builder-attribution.ts", "src/sponsored-stamp.ts", "src/sponsor-wallet-setup.ts", "src/public-pages.ts", "src/workers"]
}
