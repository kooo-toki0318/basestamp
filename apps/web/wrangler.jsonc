{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "basestamp-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-03",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "APP_ENV": "production",
    "MAINNET_WRITES_ENABLED": "false",
    "SPONSOR_ENABLED": "false",
    "X402_TESTNET_ENABLED": "false",
    "X402_MAINNET_ENABLED": "false",
    "SIWE_ALLOWED_DOMAIN": "basestamp-web.ndun000.workers.dev",
    "SIWE_ALLOWED_ORIGIN": "https://basestamp-web.ndun000.workers.dev",
    "SIWE_CHAIN_IDS": "84532,8453",
    "SPONSOR_POLICY_VERSION": "1",
    "TURNSTILE_ALLOWED_HOSTNAMES": "basestamp-web.ndun000.workers.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "basestamp-db",
      "database_id": "bdcbacfb-27fd-4cdb-a6fd-c09cba864def",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["17 * * * *"]
  },
  "observability": {
    "enabled": false
  },
  "secrets": {
    // Sponsorship secrets become required as part of its explicit release gate.
    "required": ["SESSION_HASH_SECRET"]
  }
}
