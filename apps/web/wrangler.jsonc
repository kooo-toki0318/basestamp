{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "basestamp-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-03",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/.well-known/security.txt"]
  },
  "vars": {
    "APP_ENV": "production",
    "SPONSOR_ENABLED": "true",
    "X402_TESTNET_ENABLED": "false",
    "X402_MAINNET_ENABLED": "false",
    "SIWE_ALLOWED_DOMAIN": "basestamp-web.ndun000.workers.dev",
    "SIWE_ALLOWED_ORIGIN": "https://basestamp-web.ndun000.workers.dev",
    "SIWE_CHAIN_IDS": "84532,8453",
    "SECURITY_CONTACT_URL": "https://github.com/kooo-toki0318/basestamp/security/advisories/new",
    "SPONSOR_POLICY_VERSION": "3",
    "SPONSOR_ALLOWED_ORIGINS": "https://keys.coinbase.com",
    "TURNSTILE_ALLOWED_HOSTNAMES": "basestamp-web.ndun000.workers.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "basestamp-db",
      "database_id": "bdcbacfb-27fd-4cdb-a6fd-c09cba864def",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["17 * * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": false
    }
  },
  "secrets": {
    "required": [
      "SESSION_HASH_SECRET",
      "BASE_BUILDER_CODE",
      "CDP_PAYMASTER_URL",
      "CDP_PAYMASTER_URL_MAINNET",
      "SPONSOR_ID_HMAC_SECRET",
      "TURNSTILE_SECRET_KEY",
      "MAINNET_RPC_URL"
    ]
  }
}
