{
  "name": "@basestamp/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && node ../../scripts/sanitize-web-build.mjs",
    "cf-typegen": "wrangler types worker/env.d.ts --include-runtime false",
    "dev": "vite --host 0.0.0.0",
    "d1:migrate:local": "wrangler d1 migrations apply DB --local",
    "d1:migrations:list:local": "wrangler d1 migrations list DB --local",
    "lint": "eslint .",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run && vitest run --config vitest.d1.config.ts",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@base-org/account": "2.5.8",
    "@tanstack/react-query": "5.101.4",
    "hono": "4.12.34",
    "ox": "0.14.33",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "uqr": "0.1.3",
    "viem": "2.55.10",
    "wagmi": "3.7.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.50.0",
    "@cloudflare/vitest-pool-workers": "0.19.1",
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0",
    "vitest": "4.1.10",
    "wrangler": "4.125.0"
  }
}
